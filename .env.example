# Copie para .env e preencha apenas o que for usar.
# Segredos reais devem ficar no keyring do sistema,
# nao neste arquivo. Este arquivo serve para desenvolvimento.

# ---------------------------------------------------------------- geral
DEALHUNTER_GENERAL__LANGUAGE=pt-BR
DEALHUNTER_GENERAL__CURRENCY=BRL
DEALHUNTER_GENERAL__TIMEZONE=America/Sao_Paulo
DEALHUNTER_GENERAL__RESULTS_LIMIT=20
DEALHUNTER_GENERAL__LOG_LEVEL=info

# ---------------------------------------------------------------- busca
DEALHUNTER_SEARCH__TIMEOUT_SECONDS=20
DEALHUNTER_SEARCH__MAX_CONCURRENCY=6

# ---------------------------------------------------------------- monitor
DEALHUNTER_MONITOR__INTERVAL_SECONDS=600
DEALHUNTER_MONITOR__QUIET_HOURS_START=22:00
DEALHUNTER_MONITOR__QUIET_HOURS_END=07:00

# ---------------------------------------------------------------- IA (opcional)
DEALHUNTER_AI__ENABLED=false
DEALHUNTER_AI__MODEL=

# ---------------------------------------------------------------- notificacoes
DEALHUNTER_NOTIFICATIONS__CHANNELS=["console"]
# E-mail (opcional). A senha NUNCA vai no TOML nem no .env versionado.
# DEALHUNTER_NOTIFICATIONS__SMTP_HOST=smtp.exemplo.com
# DEALHUNTER_NOTIFICATIONS__SMTP_PORT=587
# DEALHUNTER_NOTIFICATIONS__SMTP_USER=conta@exemplo.com
# DEALHUNTER_NOTIFICATIONS__EMAIL_FROM=conta@exemplo.com
# DEALHUNTER_NOTIFICATIONS__EMAIL_TO=voce@exemplo.com
# DEALHUNTER_SMTP_PASSWORD=

# ---------------------------------------------------------------- fontes
# `fixture` e dados FICTICIOS de demonstracao (offline). Use apenas para testar.
DEALHUNTER_SOURCES__ENABLED=["mercadolivre"]
DEALHUNTER_SOURCES__RESPECT_ROBOTS=true
# Token de aplicacao do Mercado Livre (opcional; aumenta limites).
# DEALHUNTER_MELI_ACCESS_TOKEN=
# FEED_JSON_URLS=["https://loja.exemplo.com/api/ofertas.json"]
