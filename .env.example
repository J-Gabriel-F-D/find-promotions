# Copie para .env e preencha apenas o que for usar.
# Segredos reais devem ficar no keyring do sistema (dealhunter config set-secret),
# nao neste arquivo. Este arquivo serve para desenvolvimento.

# ---------------------------------------------------------------- geral
DEALHUNTER_GENERAL__LANGUAGE=pt-BR
DEALHUNTER_GENERAL__CURRENCY=BRL
DEALHUNTER_GENERAL__TIMEZONE=America/Sao_Paulo
DEALHUNTER_GENERAL__RESULTS_LIMIT=20
DEALHUNTER_GENERAL__LOG_LEVEL=info

# ---------------------------------------------------------------- busca
DEALHUNTER_SEARCH__TIMEOUT_SECONDS=20
DEALHUNTER_SEARCH__MAX_CONCURRENCY=6

# ---------------------------------------------------------------- monitor
DEALHUNTER_MONITOR__INTERVAL_SECONDS=600
DEALHUNTER_MONITOR__QUIET_HOURS_START=22:00
DEALHUNTER_MONITOR__QUIET_HOURS_END=07:00

# ---------------------------------------------------------------- IA (opcional)
DEALHUNTER_AI__ENABLED=false
DEALHUNTER_AI__MODEL=

# ---------------------------------------------------------------- notificacoes
DEALHUNTER_NOTIFICATIONS__CHANNELS=["console"]

# ---------------------------------------------------------------- fontes
DEALHUNTER_SOURCES__ENABLED=["mercadolivre","fixture"]
